# Copy this file to .env.local for local development, or set these as
# environment variables in your hosting platform's dashboard for production.
# See DEPLOYMENT.md for a full production deployment walkthrough (Netlify).

# Required in production. Signs the session cookie (JWT) — without a real
# value here the app falls back to a well-known dev secret, which is NOT
# safe once the site is public. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string. On Netlify, leave this UNSET — Netlify
# Database injects NETLIFY_DB_URL automatically once the database is
# provisioned and linked to the site, and src/lib/db.ts picks that up on
# its own. Set DATABASE_URL yourself only for local development against a
# Postgres instance you're running (e.g. via `docker run postgres` or a
# local install), e.g.:
#   postgres://postgres:postgres@localhost:5432/skillsacademy_dev
DATABASE_URL=

# Optional, local development only. Where uploaded module files
# (Word/PDF/PPT/etc.) are stored when no Netlify Blobs context is
# available (i.e. plain `npm run dev` without the Netlify CLI). Defaults to
# ./uploads inside the project directory. Has no effect on Netlify — Blobs
# is used there automatically, no configuration needed.
UPLOAD_DIR=

# Set automatically by most hosting platforms (including Netlify) — you
# don't need to set this yourself. Enables secure, httpOnly cookies.
NODE_ENV=production
